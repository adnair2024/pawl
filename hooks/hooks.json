{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node --liftoff-only \"${CLAUDE_PLUGIN_ROOT}/dist/cli.js\" hook post-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --liftoff-only \"${CLAUDE_PLUGIN_ROOT}/dist/cli.js\" hook stop",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node --liftoff-only \"${CLAUDE_PLUGIN_ROOT}/dist/cli.js\" hook guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node --liftoff-only \"${CLAUDE_PLUGIN_ROOT}/dist/cli.js\" hook pre-commit",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -d \"${CLAUDE_PLUGIN_ROOT}/node_modules/@ast-grep/napi\" ] || (cd \"${CLAUDE_PLUGIN_ROOT}\" && npm install --omit=dev --no-audit --no-fund --silent)",
            "timeout": 180
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --liftoff-only \"${CLAUDE_PLUGIN_ROOT}/dist/cli.js\" hook prompt",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
